# Three lanes, and the order inside `beta` is the design — every step that can
# fail cheaply runs before the twenty-five minute one.
#
#   bundle exec fastlane certificates          # local only, once
#   bundle exec fastlane preflight             # three minutes, no build
#   bundle exec fastlane beta flavor:prod bump:true notes:"..."
#
# **This file never archives.** `tool/build-ipa.sh` does, because the app's
# configuration arrives through `--dart-define-from-file` and `gym` knows
# nothing about that flag. See docs/rules/RELEASE.md.

require "json"
require "shellwords"

default_platform(:ios)

REPO_ROOT = File.expand_path("../..", __dir__)
APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
TEAM_ID = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)

platform :ios do
  # ---------------------------------------------------------------------------
  # Lanes
  # ---------------------------------------------------------------------------

  desc "Build and upload to TestFlight"
  lane :beta do |options|
    flavor = require_flavor(options)
    notes = (ENV["RELEASE_NOTES"] || options[:notes] || "").to_s.strip

    # 1. The last place the config mismatch can be caught. Nothing ties
    #    env/<flavor>.json to the installed GoogleService-Info.plist, so a
    #    prod build carrying dev's plist compiles, installs, launches and
    #    writes into the wrong Firestore.
    verify_flavor_config(flavor)

    key = api_key

    # 2. Settle the build number BEFORE the build. App Store Connect refuses a
    #    number it has already seen for this version on any branch, so without
    #    `bump` a used number is a hard error here rather than after
    #    twenty-five minutes.
    build_number = settle_build_number(bump: options[:bump].to_s == "true", api_key: key)

    # 3. Signing. CI only — a laptop already has the certificate in its
    #    keychain and Xcode's automatic signing handles the rest.
    export_options = nil

    if ci?
      # Gated on the CI provider's own variable, NOT `is_ci`. `is_ci` is true
      # on a Mac rehearsing with CI=true — the very thing the docs tell people
      # to run — and `setup_ci` there creates a throwaway keychain, adds it to
      # the search list and never removes it. The shared certificate then lives
      # in two keychains and `codesign` starts prompting at `exportArchive`,
      # after the whole build.
      setup_ci if runner?

      drop_empty_match_auth

      match(type: "appstore", readonly: true, api_key: key)

      verify_entitlements_in_profile

      use_manual_signing

      export_options = write_export_options
    end

    # 4. The build. Always through the script — see the header.
    sh("cd #{REPO_ROOT.shellescape} && sh tool/build-ipa.sh #{flavor} #{export_options.to_s.shellescape}")

    ipa = Dir[File.join(REPO_ROOT, "build/ios/ipa/*.ipa")].first
    UI.user_error!("no .ipa in build/ios/ipa") if ipa.nil?

    # 5. Upload. macOS minutes bill at 10x and nothing in this lane reads the
    #    result, so processing is not waited on — except when there is a note
    #    to attach, which is the only thing on the build that says dev or prod.
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      skip_waiting_for_build_processing: notes.empty?,
      changelog: notes.empty? ? nil : notes,
      distribute_external: false,
      skip_submission: true
    )

    # 6. dSYMs, best effort. The build is already up; a symbol failure must not
    #    take the build-number commit down with it.
    upload_dsyms(flavor)

    # 7. Commit the number, after the upload. A bump commit with no build is a
    #    gap in the numbering; a build whose number is in no commit is the
    #    thing this ordering exists to prevent.
    commit_build_number(build_number) if options[:bump].to_s == "true"

    UI.success("#{flavor} build #{build_number} uploaded")
  end

  desc "Everything a release depends on except the build"
  lane :preflight do |options|
    # `flavor:` is optional and SKIPPED when absent, never defaulted.
    # Defaulting to prod would fail a rehearsal on a dev machine over the one
    # question it was not asked.
    if options[:flavor]
      verify_flavor_config(options[:flavor].to_s)
    else
      UI.important("no flavor: — skipping the config check")
    end

    key = api_key
    UI.success("App Store Connect API key accepted")

    settle_build_number(bump: false, api_key: key)

    if ci?
      setup_ci if runner?
      drop_empty_match_auth
      match(type: "appstore", readonly: true, api_key: key)
      verify_entitlements_in_profile
    else
      UI.important("CI is not set — skipping match. Re-run as `CI=true bundle exec fastlane preflight`")
    end

    UI.success("preflight clean")
  end

  desc "Create or refresh the signing certificates and profiles. Local only."
  lane :certificates do |options|
    # Local only, deliberately. CI runs `match(readonly: true)`: a runner that
    # can mint distribution certificates burns through Apple's limit of three,
    # one failed job at a time.
    UI.user_error!("`certificates` is local only — never run it on CI") if runner?

    drop_empty_match_auth

    # `force` regenerates the PROFILES, not the certificate, and it is the only
    # way a newly-enabled capability ever reaches CI: match reuses an existing
    # profile otherwise, which is the trap behind every "profile doesn't
    # include the … entitlement".
    match(type: "appstore", readonly: false, force: options[:force].to_s == "true", api_key: api_key)
  end

  # ---------------------------------------------------------------------------
  # Helpers
  # ---------------------------------------------------------------------------

  # True on a real runner. `is_ci` is not the same question — see the comment
  # in `beta`.
  def runner?
    ENV["GITHUB_ACTIONS"] == "true"
  end

  def ci?
    is_ci
  end

  def require_flavor(options)
    flavor = options[:flavor].to_s

    UI.user_error!("flavor: must be dev or prod") unless %w[dev prod].include?(flavor)

    flavor
  end

  # Named all at once, and never with `ENV.fetch` alone: an unconfigured
  # machine deserves the name of the file to create, not a Ruby KeyError and a
  # stack trace through fastlane's runner. Empty counts as missing — CI sets
  # every secret it names, empty string included.
  def api_key
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILEPATH].reject { |name| ENV[name].to_s.strip != "" }

    unless missing.empty?
      source = ci? ? "the workflow's Actions secrets" : "ios/fastlane/.env, copied from .env.example"
      UI.user_error!("no App Store Connect API key: #{missing.join(', ')} unset. Set them in #{source} — see docs/release/CREDENTIALS.md")
    end

    path = ENV.fetch("ASC_KEY_FILEPATH")

    UI.user_error!("ASC_KEY_FILEPATH points at nothing: #{path}") unless File.exist?(path)

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: path,
      in_house: false
    )
  end

  # Actions sets every `${{ secrets.X }}` a workflow names, empty string
  # included, and match reads BOTH auth variables from the environment
  # regardless of what the call site passes — giving
  # `remote: Duplicate header: "Authorization"`. Choosing one in code is not
  # enough; the empty one has to leave ENV.
  def drop_empty_match_auth
    %w[MATCH_GIT_BASIC_AUTHORIZATION MATCH_GIT_BEARER_AUTHORIZATION].each do |name|
      ENV.delete(name) if ENV[name].to_s.strip.empty?
    end
  end

  # Read the project id out of the plist that is actually installed and refuse
  # unless `.firebaserc` agrees it belongs to this flavor. Also checks the
  # sign-in URL scheme and the Crashlytics app id, which are the other two
  # things that fail silently rather than loudly.
  def verify_flavor_config(flavor)
    plist = File.join(REPO_ROOT, "ios/Runner/GoogleService-Info.plist")
    firebaserc = File.join(REPO_ROOT, ".firebaserc")
    env_file = File.join(REPO_ROOT, "env/#{flavor}.json")

    UI.user_error!("no ios/Runner/GoogleService-Info.plist — run `melos run prepare-env-#{flavor}`") unless File.exist?(plist)
    UI.user_error!("no .firebaserc — nothing says which project `#{flavor}` is. See RELEASE_ACTIONS.md") unless File.exist?(firebaserc)
    UI.user_error!("no env/#{flavor}.json — run `melos run prepare-env-#{flavor}`") unless File.exist?(env_file)

    installed = plist_value(plist, "PROJECT_ID")
    expected = JSON.parse(File.read(firebaserc)).dig("projects", flavor)

    UI.user_error!("`.firebaserc` names no project for `#{flavor}`") if expected.nil?

    if installed != expected
      UI.user_error!("GoogleService-Info.plist is project `#{installed}`, but `#{flavor}` is `#{expected}` — run `melos run prepare-env-#{flavor}`")
    end

    reversed = plist_value(plist, "REVERSED_CLIENT_ID")
    info = File.read(File.join(REPO_ROOT, "ios/Runner/Info.plist"))

    unless reversed.to_s.empty? || info.include?(reversed)
      UI.user_error!("the reversed client id is not a URL scheme in Info.plist — Google sign-in returns to nothing")
    end

    # The env file's Crashlytics app id and the plist's are the same fact
    # written twice; when they disagree the symbols go to another project's
    # dashboard and nobody notices for a month.
    env_app_id = JSON.parse(File.read(env_file))["FIREBASE_APP_ID_IOS"]
    plist_app_id = plist_value(plist, "GOOGLE_APP_ID")

    unless env_app_id.to_s.empty? || env_app_id == plist_app_id
      UI.user_error!("env/#{flavor}.json FIREBASE_APP_ID_IOS does not match the installed plist")
    end

    UI.success("#{flavor} config is consistent (project #{installed})")
  end

  def plist_value(path, key)
    `/usr/libexec/PlistBuddy -c "Print :#{key}" #{path.shellescape} 2>/dev/null`.strip
  end

  # max(pubspec, TestFlight) + 1, written INTO pubspec.yaml, never passed as a
  # flag. TestFlight is consulted because App Store Connect refuses a number it
  # has already seen for this version, on any branch.
  def settle_build_number(bump:, api_key:)
    version, current = pubspec_version

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    ).to_i

    if bump
      settled = [current, latest].max + 1
      write_pubspec_build_number(version, settled)
      UI.success("build number #{settled} (was #{current}, TestFlight had #{latest})")
    else
      settled = current
      UI.user_error!("build #{version}+#{settled} is already on TestFlight — re-run with bump:true") if settled <= latest
      UI.success("build number #{settled} is free (TestFlight has #{latest})")
    end

    settled
  end

  def pubspec_path
    File.join(REPO_ROOT, "pubspec.yaml")
  end

  def pubspec_version
    line = File.readlines(pubspec_path).find { |l| l.start_with?("version:") }

    UI.user_error!("no `version:` line in pubspec.yaml") if line.nil?

    name, build = line.sub("version:", "").strip.split("+")

    [name, build.to_i]
  end

  def write_pubspec_build_number(version, build)
    body = File.read(pubspec_path).sub(/^version:.*$/, "version: #{version}+#{build}")

    File.write(pubspec_path, body)
  end

  def commit_build_number(build)
    version, = pubspec_version

    sh("cd #{REPO_ROOT.shellescape} && git add pubspec.yaml && git commit -m 'chore: release - build #{version}+#{build}'")
  end

  # Crashlytics symbols. Best effort by design, and it is the one step allowed
  # to swallow its own failure: the build is already on TestFlight, and taking
  # the lane down here would lose the build-number commit that comes after it.
  #
  # There is no Podfile in this project — the SDKs come in through SPM — so the
  # `upload-symbols` binary sits under DerivedData rather than at a fixed path.
  # Not finding it is a warning, never an error.
  def upload_dsyms(flavor)
    app_id = ENV["FIREBASE_APP_ID_IOS"].to_s

    return UI.important("FIREBASE_APP_ID_IOS is unset — skipping the dSYM upload") if app_id.empty?

    dsyms = Dir[File.join(REPO_ROOT, "build/ios/archive/*.xcarchive/dSYMs")].first
    binary = Dir[File.join(Dir.home, "Library/Developer/Xcode/DerivedData/**/upload-symbols")].first
    plist = File.join(REPO_ROOT, "ios/Runner/GoogleService-Info.plist")

    return UI.important("no dSYMs in the archive — skipping") if dsyms.nil?
    return UI.important("no upload-symbols binary — skipping the dSYM upload for #{flavor}") if binary.nil?

    upload_symbols_to_crashlytics(
      dsym_path: dsyms,
      app_id: app_id,
      gsp_path: plist,
      binary_path: binary
    )
  rescue StandardError => error
    UI.important("dSYM upload failed, continuing: #{error.message}")
  end

  # Every entitlement the target claims must be in the profile match handed us.
  # A capability enabled in the portal after the profile was minted is not in
  # it, and `exportArchive` says so only after the full build.
  def verify_entitlements_in_profile
    entitlements = File.join(REPO_ROOT, "ios/Runner/Runner.entitlements")
    profile = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-path"]

    return UI.important("no entitlements file — nothing to check") unless File.exist?(entitlements)
    UI.user_error!("match set no profile path") if profile.to_s.empty?

    decoded = `security cms -D -i #{profile.shellescape} 2>/dev/null`
    claimed = `/usr/libexec/PlistBuddy -c "Print" #{entitlements.shellescape}`.scan(/^\s{4}(\S+) = /).flatten

    missing = claimed.reject { |key| decoded.include?(key) }

    unless missing.empty?
      UI.user_error!("the profile is missing #{missing.join(', ')} — run `bundle exec fastlane certificates force:true` from a Mac")
    end

    UI.success("the profile carries every entitlement the target claims")
  end

  # Flip this checkout to manual signing. CI has no keychain Xcode can pick a
  # team from, and automatic signing there resolves to nothing.
  def use_manual_signing
    update_code_signing_settings(
      path: File.join(REPO_ROOT, "ios/Runner.xcodeproj"),
      use_automatic_signing: false,
      team_id: TEAM_ID,
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
    )
  end

  # Written by hand, with every bundle id in it. `flutter build ipa
  # --export-method` generates its own and maps the MAIN bundle id only — its
  # own source calls multi-target apps a TODO. With automatic signing that
  # never shows; with manual signing an extension gets no profile and
  # `exportArchive` fails after the full build.
  def write_export_options
    path = File.join(__dir__, "ExportOptions.plist")

    profiles = [APP_IDENTIFIER].map do |identifier|
      "      <key>#{identifier}</key>\n      <string>#{ENV["sigh_#{identifier}_appstore_profile-name"]}</string>"
    end.join("\n")

    File.write(path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>#{TEAM_ID}</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>uploadSymbols</key>
        <true/>
        <key>provisioningProfiles</key>
        <dict>
      #{profiles}
        </dict>
      </dict>
      </plist>
    PLIST

    path
  end
end
