# What this app is, and nothing else. The lanes live in the design system.
#
#   bundle exec fastlane certificates          # local only, once
#   bundle exec fastlane preflight             # three minutes, no build
#   bundle exec fastlane beta flavor:prod bump:true notes:"..."
#   bundle exec fastlane upload flavor:prod    # a built IPA that failed to upload
#
# `beta`, `upload`, `preflight` and `certificates` are imported, never copied:
# every app embedding this design system ships through one pipeline, and a lane
# re-implemented here is one that stops getting the next fix. This file only
# says which bundle ids, which team and which targets that pipeline is aiming
# at. See docs/rules/RELEASE.md.
#
# **Nothing here archives.** `packages/system_design/tool/build-ipa.sh` does,
# because the app's configuration arrives through `--dart-define-from-file` and
# `gym` knows nothing about that flag.
import "../../packages/system_design/tool/fastlane/Fastfile"

# `targets` is ORDERED and the first one is the app itself — the bundle id every
# upload, config check and TestFlight query uses. An extension added later is
# appended here AND to the Matchfile, or match mints no profile for it and
# `exportArchive` fails after the full build.
sd_ios_app(
  team_id: "WNG5UWNJ6H",
  targets: [
    {
      name: "Runner",
      bundle_id: "app.dd.reseller.studio",
      entitlements: "Runner/Runner.entitlements",
    },
  ],
)
