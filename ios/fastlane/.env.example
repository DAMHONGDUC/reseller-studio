# The six local credentials. Copy to `ios/fastlane/.env`, which is gitignored,
# and fill in. **Never commit the real file** and never echo a value — see
# docs/release/CREDENTIALS.md.
#
# Check the shape without reading any value:
#
#   cut -d= -f1 ios/fastlane/.env
#
# **The file must end with a newline.** `>>` appends bytes, not lines, so a
# missing one turns the next appended variable into a suffix of the previous
# value — and the symptom is "the previous variable is nonsense", not
# "variable missing".

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=
MATCH_PASSWORD=
MATCH_GIT_URL=
MATCH_GIT_BASIC_AUTHORIZATION=
