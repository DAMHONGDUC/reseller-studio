{
  "name": "seller-os-functions",
  "description": "Cloud Functions for Reseller Studio \u2014 the trusted half of the app.",
  "main": "lib/index.js",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "test": "node --test test/entitlement.test.mjs test/usage.test.mjs test/server_surface.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules \"node --test test/firestore_rules.test.mjs\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.1",
    "firebase-tools": "^15.27.0",
    "typescript": "^5.9.3"
  }
}
