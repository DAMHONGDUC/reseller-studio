# Build-time configuration. The real files can hold ids that identify a
# project; the templates carry the key list and nothing else. See env/README.md
# — none of this is a secret store, and secrets must not go in either.
env/*.json
!env/*.example.json

# Firebase — generated per-project, and they carry real project identifiers.
# Regenerate with `flutterfire configure`; see CLAUDE.md "Pending setup".
lib/firebase_options.dart
**/google-services.json
**/GoogleService-Info.plist
.firebase/
firestore-debug.log
firebase-debug.log
ui-debug.log

# Cloud Functions
functions/node_modules/
functions/lib/

# Melos
pubspec_overrides.yaml

# Scratch work that must never reach CI.
#
# `*_tmp_test.dart` — throwaway harnesses (screenshot shooters, geometry
# probes). They are written to be run by hand against one question and are
# often built on `matchesGoldenFile` or `dart:io`, which hang the runner here:
# `shot_tmp_test.dart` times out at 10 minutes per case. `melos run test`
# picks up anything matching `*_test.dart`, so the only thing keeping one out
# of a CI run is this line.
*_tmp_test.dart
test/**/shots/

# Backups left beside the file they copy — `CLAUDE.md.orig.bak` and friends.
# Made before a large rewrite so the original can be diffed against the
# result; git already holds the committed history, so these never belong in it.
*.orig.bak
