{
  "@@locale": "en",

  "appTitle": "Seller OS",
  "@appTitle": {
    "description": "The app's own name. Not translated in either locale."
  },

  "navHome": "Home",
  "@navHome": {
    "description": "Bottom tab 1 — answers 'what do I need to do today?'"
  },
  "navInventory": "Inventory",
  "@navInventory": {
    "description": "Bottom tab 2 — answers 'what do I have?'"
  },
  "navOrders": "Orders",
  "@navOrders": {
    "description": "Bottom tab 3 — answers 'what am I selling/processing?'"
  },
  "navAnalytics": "Analytics",
  "@navAnalytics": {
    "description": "Bottom tab 4 — answers 'how is my business performing?'"
  },
  "navMore": "More",
  "@navMore": {
    "description": "Bottom tab 5 — everything else."
  },

  "actionSave": "Save",
  "@actionSave": {
    "description": "Primary confirm on any create/edit form."
  },
  "actionCancel": "Cancel",
  "@actionCancel": {
    "description": "Low-emphasis dismiss in a dialog or sheet."
  },
  "actionRetry": "Try again",
  "@actionRetry": {
    "description": "Recovery action on an error state."
  },
  "actionDelete": "Delete",
  "@actionDelete": {
    "description": "Destructive confirm."
  },

  "errorGenericTitle": "Something went wrong",
  "@errorGenericTitle": {
    "description": "The only failure headline a user ever sees. Raw exceptions are never shown — see CLAUDE.md hard rule 6."
  },
  "errorGenericMessage": "Please try again.",
  "@errorGenericMessage": {
    "description": "Body under errorGenericTitle."
  },
  "errorOfflineTitle": "You're offline",
  "@errorOfflineTitle": {
    "description": "Shown when a write cannot reach Firestore and is queued locally."
  },
  "errorOfflineMessage": "Your changes are saved on this device and will sync when you're back online.",
  "@errorOfflineMessage": {
    "description": "Reassurance that an offline write is not lost — Firestore's local cache holds it."
  },
  "errorSignedOutMessage": "Please sign in again to continue.",
  "@errorSignedOutMessage": {
    "description": "AppFailureKind.unauthenticated — the session expired, the credential was rejected, or an action needs a recent sign-in."
  },
  "errorNoAccessMessage": "You don't have access to do that in this workspace.",
  "@errorNoAccessMessage": {
    "description": "AppFailureKind.permissionDenied — signed in, but the member's role does not allow it."
  },
  "errorNotFoundMessage": "That's no longer there. It may have been deleted.",
  "@errorNotFoundMessage": {
    "description": "AppFailureKind.notFound — a stale link, or a row a teammate deleted while the screen was open."
  },
  "errorInvalidDataMessage": "Some details are missing or not valid.",
  "@errorInvalidDataMessage": {
    "description": "AppFailureKind.invalidData — the server rejected the write."
  },
  "errorLimitReachedMessage": "You've reached the limit on your current plan.",
  "@errorLimitReachedMessage": {
    "description": "AppFailureKind.limitReached — a free-tier cap was hit."
  },

  "emptyValuePlaceholder": "—",
  "@emptyValuePlaceholder": {
    "description": "Shown instead of a number when there is not enough data to compute it — profit with no cost entered, ROI with no sale. Never render 0 here: 0 is a claim, — is an absence. See the master plan §15."
  },

  "quickAddTitle": "Quick Add",
  "@quickAddTitle": {
    "description": "Screen title for the fastest create path, and the label on the Inventory FAB that opens it."
  },
  "quickAddNameLabel": "What is it?",
  "@quickAddNameLabel": {
    "description": "Label for the only field Quick Add requires — the item title. Phrased as a question because a seller is looking at the object while they type."
  },
  "quickAddNameHint": "Nike Air Max 90, size 10",
  "@quickAddNameHint": {
    "description": "Placeholder in the Quick Add title field. A concrete example, not the word 'Title'."
  },
  "quickAddHelp": "A title is all it takes. Price, photos and the rest can wait.",
  "@quickAddHelp": {
    "description": "Reassurance under the Quick Add field that nothing else is required — see hard rule 2."
  },
  "quickAddSaved": "Added to inventory",
  "@quickAddSaved": {
    "description": "Confirmation after Quick Add writes the item."
  },
  "quickAddEmptyTitleError": "Give it a name first",
  "@quickAddEmptyTitleError": {
    "description": "Shown when Save is pressed with an empty Quick Add title."
  },

  "itemBlockMissingPrice": "Add an asking price to list this",
  "@itemBlockMissingPrice": {
    "description": "Why an item cannot move to Listed — plan §29 state validation."
  },
  "itemBlockMissingSalePrice": "Add a sale price to mark this sold",
  "@itemBlockMissingSalePrice": {
    "description": "Why an item cannot move to Sold."
  },
  "itemBlockWrongStatus": "This item cannot move there from where it is",
  "@itemBlockWrongStatus": {
    "description": "Why a transition is refused because the item's current status is not a valid starting point."
  },
  "itemBlockNoQuantity": "Nothing left in stock to move",
  "@itemBlockNoQuantity": {
    "description": "Why a transition is refused because quantity is zero."
  }
}
