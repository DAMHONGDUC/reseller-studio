  "errorGenericTitle": "Something went wrong",
  "@errorGenericTitle": {
    "description": "The only failure headline a user ever sees. Raw exceptions are never shown — see CLAUDE.md hard rule 6."
  },
  "errorGenericMessage": "Please try again.",
  "@errorGenericMessage": {
    "description": "Body under errorGenericTitle."
  },
  "errorOfflineTitle": "You're offline",
  "@errorOfflineTitle": {
    "description": "Shown when a write cannot reach Firestore and is queued locally."
  },
  "errorOfflineMessage": "Your changes are saved on this device and will sync when you're back online.",
  "@errorOfflineMessage": {
    "description": "Reassurance that an offline write is not lost — Firestore's local cache holds it."
  },

  "emptyValuePlaceholder": "—",
  "@emptyValuePlaceholder": {
    "description": "Shown instead of a number when there is not enough data to compute it — profit with no cost entered, ROI with no sale. Never render 0 here: 0 is a claim, — is an absence. See the master plan §15."
  }
