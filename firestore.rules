rules_version = '2';

// Reseller Studio security rules.
//
// The whole model in one sentence: **every business document lives under a
// workspace, and access is decided by the caller's membership document in
// that workspace.** There is no top-level `items` or `orders` collection, and
// that is the point — a flat collection would make every rule re-derive
// ownership from a field on the document, which is one forgotten `where`
// clause away from a data leak between two sellers.
//
//   users/{uid}
//     devices/{deviceId}        ← FCM tokens, written by the app
//     notifications/{id}        ← the inbox, written only by functions
//
//   workspaces/{workspaceId}
//     members/{uid}          ← the ACL. Role lives here, nowhere else.
//     items/{itemId}
//     listings/{listingId}
//     orders/{orderId}
//     offers/{offerId}
//     purchases/{purchaseId}
//     sources/{sourceId}
//     expenses/{expenseId}
//     locations/{locationId}
//     categories/{categoryId}
//     activity/{activityId}  ← audit log, append-only, never edited
//
// Roles (plan §24): owner > admin > member > viewer.
//
// **Anything a client must not be able to forge is written by a Cloud
// Function with the Admin SDK, which bypasses these rules entirely.** That is
// the enforcement for payouts and subscription state —
// not a rule here, because a rule can only check what the client sent.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isMember(workspaceId) {
      return signedIn() && exists(memberPath(workspaceId));
    }

    function role(workspaceId) {
      return get(memberPath(workspaceId)).data.role;
    }

    // Can read the workspace's data. Every role can, viewer included — that
    // is what "viewer" means.
    function canRead(workspaceId) {
      return isMember(workspaceId);
    }

    // Can create and edit business records. Viewer deliberately cannot.
    function canWrite(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'member'];
    }

    // Can change the workspace itself: settings, members, roles.
    function canAdmin(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin'];
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) == 'owner';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Whether the workspace has run past what its plan allows.
    //
    // **A rule cannot count a collection**, only read one document — so the
    // counting happens in `onItemUsageWritten` / `onOrderUsageWritten`, which
    // write the verdict here. No ceiling is written in this file on purpose:
    // the numbers have one owner in `PlanLimits.byPlan`, mirrored once in
    // `functions/src/lib/firestore.ts`, and a third copy in rules is a copy
    // nobody would remember to change.
    //
    // **Fails open at every step**: no usage document, no such field, or a
    // value that is not the boolean the function writes, and the create goes
    // through. The failure mode of failing closed is a seller who cannot add
    // stock and no way to ship the fix (`docs/rules/BACKEND.md`).
    function withinCeiling(workspaceId, flag) {
      let usage = /databases/$(database)/documents/workspaces/$(workspaceId)/usage/current;

      return !exists(usage) || get(usage).data.get(flag, false) != true;
    }

    // --- Users -----------------------------------------------------------

    // A user's own profile. Nobody reads anyone else's: a team member's name
    // is denormalised onto the membership document, so the team screen never
    // needs to reach across into another user's record.
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      // The devices this person is signed in on, and the FCM token for each.
      // Written by the app because only the app can learn the token; read by
      // the notification functions through the Admin SDK, which bypasses
      // these rules. Nobody else may read one — a token is a way to push
      // arbitrary text onto somebody's phone.
      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid);
      }

      // The notification inbox (plan §22). **Written only by Cloud
      // Functions**, the same reasoning as the audit log: a notification a
      // client can create is one that can claim any business made any sale.
      //
      // The one thing the reader may do is mark it read, and the rule names
      // that field rather than trusting the app to send only that — an update
      // free to rewrite the body would put the create rule back where it
      // started.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow create, delete: if false;
      }
    }

    // --- Workspaces ------------------------------------------------------

    match /workspaces/{workspaceId} {
      allow read: if canRead(workspaceId);

      // Anyone signed in may create a workspace, but only as its owner and
      // only naming themselves. Without the `ownerId` check a client could
      // create a workspace owned by someone else and then read whatever that
      // person's automation wrote into it.
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if canAdmin(workspaceId)
                    // The owner cannot be reassigned by an update. Transfer
                    // of ownership is a Cloud Function, so it can move the
                    // membership documents in the same transaction.
                    && request.resource.data.ownerId == resource.data.ownerId;

      // Deleting a workspace orphans every subcollection under it — Firestore
      // does not cascade. The `deleteWorkspace` callable does the teardown;
      // no client deletes this document.
      allow delete: if false;

      // --- Membership: the ACL itself ------------------------------------

      match /members/{memberUid} {
        allow read: if canRead(workspaceId);

        // Only admins invite and remove. **Nobody edits their own membership
        // document** — without that clause a member could set their own role
        // to owner, and every rule above is decided by this document.
        //
        // The second clause is the bootstrap, and it is the one case where
        // somebody writes their own membership. `canAdmin` cannot authorise
        // it: it reads the very document being created, so the first member
        // of a new workspace could never be written and the workspace would
        // be unreadable by anyone, forever. It is narrow on purpose — only
        // the uid the workspace itself names as `ownerId`, only as `owner`,
        // and only as a create, so it cannot be used to promote anyone later.
        allow create: if canAdmin(workspaceId)
                      || (signedIn()
                          && memberUid == request.auth.uid
                          && request.resource.data.role == 'owner'
                          && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid);
        allow delete: if canAdmin(workspaceId);
        allow update: if canAdmin(workspaceId)
                      && memberUid != request.auth.uid;

        // The last owner cannot be demoted or removed, or the workspace
        // becomes unadministrable. Enforced in the `removeMember` callable,
        // which does both jobs because the check is one count either way; a
        // rule cannot take that count at all.
      }

      // --- Business records ----------------------------------------------
      //
      // Same shape for all of them, so a new collection is one line rather
      // than a new policy to reason about.

      // Items and orders are the two the Free plan puts a ceiling on (plan
      // §27), so their creates carry one more condition than the rest. Only
      // creates: a downgrade never deletes or freezes what a seller already
      // has, which is the same promise `PlanGate` makes in the app.
      match /items/{itemId} {
        allow read: if canRead(workspaceId);
        allow create: if canWrite(workspaceId) && withinCeiling(workspaceId, 'itemsAtCeiling');
        allow update, delete: if canWrite(workspaceId);
      }
      match /orders/{orderId} {
        allow read: if canRead(workspaceId);
        allow create: if canWrite(workspaceId) && withinCeiling(workspaceId, 'ordersAtCeiling');
        allow update, delete: if canWrite(workspaceId);
      }

      match /listings/{listingId}          { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /offers/{offerId}              { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /purchases/{purchaseId}        { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /sources/{sourceId}            { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /expenses/{expenseId}          { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /locations/{locationId}        { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /categories/{categoryId}       { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /marketplaces/{marketplaceId}  { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /carriers/{carrierId}          { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }
      match /receipts/{receiptId}          { allow read: if canRead(workspaceId); allow write: if canWrite(workspaceId); }

      // --- Audit log ------------------------------------------------------

      // Append-only, and never mutable. An audit log a client can edit is not
      // an audit log (plan §23). Entries are written by Cloud Functions
      // triggers so `actorId` cannot be forged.
      match /activity/{activityId} {
        allow read: if canRead(workspaceId);
        allow create, update, delete: if false;
      }

      // --- Subscription ---------------------------------------------------

      // Plan state comes from the store via a webhook. A client that could
      // write this could grant itself Business tier.
      match /subscription/{docId} {
        allow read: if canRead(workspaceId);
        allow write: if false;
      }

      // What the workspace holds, recounted by a trigger. A client that could
      // write this could clear its own ceiling flag, which is the whole thing
      // this document exists to stop.
      match /usage/{docId} {
        allow read: if canRead(workspaceId);
        allow write: if false;
      }
    }

    // --- App config -------------------------------------------------------

    // One document for the whole product, not a business record — nothing in
    // it belongs to a seller, so it is deliberately not nested under a
    // workspace (hard rule 14 governs records that are).
    //
    // Readable by anyone signed in; written by nobody with an app. The
    // premium kill switch lives here, and a client that could write it could
    // switch its own paywall off — the same reason the subscription document
    // above is `if false`.
    match /appConfig/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- Invites ----------------------------------------------------------

    // Pending invites are keyed by email so an invitee can find theirs before
    // they have a membership document anywhere. Readable only by the person
    // it was addressed to; created by an admin through a callable, which is
    // what checks the seat limit.
    match /invites/{inviteId} {
      allow read: if signedIn()
                  && request.auth.token.email == resource.data.email;
      allow write: if false;
    }

    // --- Everything else --------------------------------------------------

    // Deny by default. A collection added without a rule above is inert
    // rather than open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
